usize,\n    ) !void {\n        const result = inst.result orelse return;\n        \n        switch (inst.op) {\n            .const_int => {\n                try self.solver.addConcreteConstraint(\n                    result.id,\n                    IR.Type{ .i64 = {} },\n                    block_id,\n                    inst_id,\n                );\n            },\n            \n            .const_float => {\n                try self.solver.addConcreteConstraint(\n                    result.id,\n                    IR.Type{ .f64 = {} },\n                    block_id,\n                    inst_id,\n                );\n            },\n            \n            .const_bool => {\n                try self.solver.addConcreteConstraint(\n                    result.id,\n                    IR.Type{ .bool = {} },\n                    block_id,\n                    inst_id,\n                );\n            },\n            \n            .phi => |phi_op| {\n                // Phi 约束：result = phi(incoming...)\n                const result_tag = @as(std.meta.Tag(IR.Type), result.type_);\n                if (result_tag != .php_value) {\n                    // Phi 已经被特化，添加具体类型约束\n                    try self.solver.addConcreteConstraint(\n                        result.id,\n                        result.type_,\n                        block_id,\n                        inst_id,\n                    );\n                }\n                \n                // 收集 incoming 值的 ID\n                var incoming_ids = std.ArrayList(usize).init(self.allocator);\n                defer incoming_ids.deinit();\n                \n                for (phi_op.incoming.items) |incoming| {\n                    try incoming_ids.append(incoming.value.id);\n                }\n                \n                try self.solver.addPhiConstraint(\n                    incoming_ids.items,\n                    result.id,\n                    block_id,\n                    inst_id,\n                );\n     