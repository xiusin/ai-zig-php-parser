                  {
                    "Json": {
                      "exit_status": "0",
                      "stdout": "diff --git a/zig-php-parser/src/aot/type_specialization_pass.zig b/zig-php-parser/src/aot/type_specialization_pass.zig\nindex 837c258..86a9fbb 100644\n--- a/zig-php-parser/src/aot/type_specialization_pass.zig\n+++ b/zig-php-parser/src/aot/type_specialization_pass.zig\n@@ -124,6 +124,32 @@ pub const TypeSpecializationPass = struct {\n                             }\n                         }\n                     },\n+                    .add, .sub, .mul, .div, .mod => |*op| {\n+                        // 只在结果类型推断为 i64 时才穿透\n+                        if (inst.*.result) |result| {\n+                            const result_type = self.type_inference.getInferredType(result.id);\n+                            if (result_type) |rt| {\n+                                const result_tag = @as(std.meta.Tag(IR.Type), rt);\n+                                if (result_tag == .i64) {\n+                                    const lhs_tag = @as(std.meta.Tag(IR.Type), op.lhs.type_);\n+                                    const rhs_tag = @as(std.meta.Tag(IR.Type), op.rhs.type_);\n+                                    \n+                                    if (lhs_tag == .php_value and rhs_tag == .i64) {\n+                                        if (cast_sources.get(op.lhs.id)) |source| {\n+                                            op.lhs = source;\n+                                            self.stats.casts_eliminated += 1;\n+                                        }\n+                                    }\n+                                    else if (lhs_tag == .i64 and rhs_tag == .php_value) {\n+                                        if (cast_sources.get(op.rhs.id)) |source| {\n+                                            op.rhs = source;\n+                                            self.stats.casts_eliminated += 1;\n+                                        }\n+                                    }\n+                                }\n+                            }\n+                        }\n+                    },\n                     else => {},\n                 }\n             }",
                      "stderr": ""
                    }
                  }
                ],
                "status": "Success"
              }
            ]
          }
        },
