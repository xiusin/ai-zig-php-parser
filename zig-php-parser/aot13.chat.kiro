                "new_str": "/// 类型约束的种类\npub const ConstraintKind = enum {\n    /// 等式约束：T1 = T2\n    equality,\n    /// 具体类型约束：T1 = i64\n    concrete,\n    /// 二元操作约束：T1 op T2 = T3\n    binary_op,\n    /// Phi 约束：phi(T1, T2, ...) = Tn\n    phi,\n};\n\n/// 操作类型标签（简化版）\npub const OpTag = enum {\n    add,\n    sub,\n    mul,\n    div,\n    mod,\n    other,\n};\n\n/// 类型约束\npub const Constraint = struct {\n    kind: ConstraintKind,\n    data: union {\n        /// 等式约束：lhs = rhs\n        equality: struct {\n            lhs: TypeVar,\n            rhs: TypeVar,\n        },\n        /// 具体类型：var = type\n        concrete: struct {\n            var_: TypeVar,\n            type_: IR.Type,\n        },\n        /// 二元操作：lhs op rhs = result\n        binary_op: struct {\n            op: OpTag,\n            lhs: TypeVar,\n            rhs: TypeVar,\n            result: TypeVar,\n        },",
