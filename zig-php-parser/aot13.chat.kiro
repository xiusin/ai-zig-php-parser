              "args": {
                "command": "str_replace",
                "new_str": "            .add, .sub, .mul, .div, .mod => |bin_op| {\n                // 二元操作约束：result = lhs op rhs\n                const op_tag: TypeConstraintSolver.OpTag = switch (@as(std.meta.Tag(IR.Op), inst.op)) {\n                    .add => .add,\n                    .sub => .sub,\n                    .mul => .mul,\n                    .div => .div,\n                    .mod => .mod,\n                    else => .other,\n                };\n                \n                try self.solver.addBinaryOpConstraint(\n                    op_tag,\n                    bin_op.lhs.id,\n                    bin_op.rhs.id,\n                    result.id,\n                    block_id,\n                    inst_id,\n                );\n            },",
